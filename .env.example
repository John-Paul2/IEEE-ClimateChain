# VeriCEMS Testnet & Local Environment Configuration
# NEVER commit .env to version control

# EVM Network Configuration
# Arbitrum Sepolia (Chain ID: 421614)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_ID=421614
VERICEMS_PROFILE=testnet

# Deployer Keystore & Password File (Foundry cast keystore)
DEPLOYER_ACCOUNT=vericems-deployer
PASSWORD_FILE=.keystore_password

# Block Explorer Verification (Optional: Arbiscan API Key from https://arbiscan.io/)
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# Backend / Web Server Configuration
HOST=127.0.0.1
PORT=8000
VITE_CHAIN_ID=421614
VITE_EXPLORER_BASE_URL=https://sepolia.arbiscan.io
